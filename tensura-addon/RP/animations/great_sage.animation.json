{
  "format_version": "1.8.0",
  "animations": {
    "animation.tensura.great_sage.float": {
      "loop": true,
      "bones": {
        "root": { "position": [0, "4 + math.sin(query.life_time * 110) * 1.2", 0] },
        "head": { "rotation": ["math.sin(query.life_time * 55) * 3", "math.sin(query.life_time * 35) * 5", 0] },
        "hair_back": { "rotation": ["6 + math.sin(query.life_time * 80) * 4", 0, "math.sin(query.life_time * 60) * 2"] },
        "coat_lower": { "rotation": ["4 + math.sin(query.life_time * 80 + 40) * 3", 0, 0] },
        "rightArm": { "rotation": ["-6 + math.sin(query.life_time * 90) * 4", 0, "10 + math.sin(query.life_time * 70) * 3"] },
        "leftArm": { "rotation": ["-6 + math.sin(query.life_time * 90 + 60) * 4", 0, "-10 - math.sin(query.life_time * 70) * 3"] },
        "rightLeg": { "rotation": [10, 0, 2] },
        "leftLeg": { "rotation": [18, 0, -2] },
        "ring_halo": { "rotation": [0, "query.life_time * 60", 0] },
        "ring_waist": { "rotation": [0, "-query.life_time * 45", 0] },
        "ring_base": {
          "rotation": [0, "query.life_time * 30", 0],
          "scale": "1 + math.sin(query.life_time * 150) * 0.06"
        }
      }
    },
    "animation.tensura.great_sage.talk": {
      "loop": true,
      "bones": {
        "head": { "rotation": ["math.sin(query.life_time * 420) * 2.5", "math.sin(query.life_time * 90) * 7", 0] },
        "rightArm": { "rotation": ["-38 + math.sin(query.life_time * 200) * 10", -12, "22 + math.sin(query.life_time * 150) * 5"] }
      }
    },
    "animation.tensura.great_sage.appear": {
      "animation_length": 1.2,
      "loop": "hold_on_last_frame",
      "bones": {
        "root": {
          "scale": { "0.0": [0.01, 0.01, 0.01], "0.8": [1.1, 1.1, 1.1], "1.2": [1, 1, 1] },
          "position": { "0.0": [0, -12, 0], "1.2": [0, 0, 0] }
        },
        "ring_base": { "scale": { "0.0": [2.5, 2.5, 2.5], "1.0": [1, 1, 1] } },
        "ring_halo": { "scale": { "0.0": [0.01, 0.01, 0.01], "0.6": [0.01, 0.01, 0.01], "1.2": [1, 1, 1] } }
      }
    },
    "animation.tensura.great_sage.vanish": {
      "animation_length": 0.8,
      "loop": "hold_on_last_frame",
      "bones": {
        "root": {
          "scale": { "0.0": [1, 1, 1], "0.25": [1.15, 1.15, 1.15], "0.8": [0.01, 0.01, 0.01] },
          "position": { "0.0": [0, 0, 0], "0.8": [0, 18, 0] }
        },
        "ring_base": { "scale": { "0.0": [1, 1, 1], "0.8": [3, 3, 3] } }
      }
    }
  }
}
