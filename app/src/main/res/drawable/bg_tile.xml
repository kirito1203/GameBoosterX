<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1A1A10" />
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="@color/solar_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#FF050A16"
                android:startColor="#FF0E1D38" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#802EA8FF" />
        </shape>
    </item>
</selector>
