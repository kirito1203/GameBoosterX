<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#55FF1744" />
            <stroke android:width="1dp" android:color="#FFFF1744" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FF1744" />
            <stroke android:width="1dp" android:color="#CCFF1744" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>
