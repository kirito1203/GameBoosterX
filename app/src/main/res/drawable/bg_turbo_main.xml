<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFF1744" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#40FF1744" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#FFB0102E" android:centerColor="#FFFF1744" android:endColor="#FFB0102E" />
                    <corners android:radius="7dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
