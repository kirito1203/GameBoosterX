<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="24dp">

        <!-- Cabeçalho / logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:importantForAccessibility="no"
                android:src="@drawable/logo_gbx" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12"
                    android:shadowColor="@color/red"
                    android:shadowRadius="14"
                    android:text="@string/brand"
                    android:textColor="@color/text"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.4"
                    android:text="@string/brand_sub"
                    android:textColor="@color/red"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:padding="10dp"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_line" />

        <TextView
            android:id="@+id/txtStatus"
            style="@style/GbxBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:textSize="11sp" />

        <!-- Indicadores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_glow"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.gameboosterx.rog.views.GaugeView
                    android:id="@+id/gaugeRam"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.gameboosterx.rog.views.GaugeView
                    android:id="@+id/gaugeBattery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.gameboosterx.rog.views.GaugeView
                    android:id="@+id/gaugeTemp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.gameboosterx.rog.views.GaugeView
                    android:id="@+id/gaugeFps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- Botões principais -->
        <TextView
            android:id="@+id/btnTurbo"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_turbo_main"
            android:clickable="true"
            android:drawableStart="@drawable/ic_turbo"
            android:drawablePadding="10dp"
            android:drawableTint="@color/text"
            android:focusable="true"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:paddingStart="60dp"
            android:paddingEnd="60dp"
            android:shadowColor="#FF000000"
            android:shadowRadius="6"
            android:text="@string/turbo"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnOptimize"
                style="@style/GbxNeonButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_optimize"
                android:text="@string/optimize" />

            <TextView
                android:id="@+id/btnSidebar"
                style="@style/GbxNeonButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_sidebar"
                android:text="@string/sidebar" />
        </LinearLayout>

        <!-- Jogos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/GbxSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/my_games" />

            <TextView
                android:id="@+id/btnGames"
                style="@style/GbxSmallButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manage" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/gamesRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/txtNoGames"
            style="@style/GbxBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:text="@string/no_games"
            android:visibility="gone" />

        <!-- Módulos -->
        <TextView
            style="@style/GbxSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/modules" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/modFps"
                style="@style/GbxTile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_fps"
                android:text="FPS STABILIZER" />

            <TextView
                android:id="@+id/modThermal"
                style="@style/GbxTile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_thermal"
                android:text="THERMAL" />

            <TextView
                android:id="@+id/modNetwork"
                style="@style/GbxTile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_network"
                android:text="NETWORK" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/modTouch"
                style="@style/GbxTile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_touch"
                android:text="TOUCH BOOST" />

            <TextView
                android:id="@+id/modRefresh"
                style="@style/GbxTile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_refresh"
                android:text="REFRESH RATE" />

            <TextView
                android:id="@+id/modSessions"
                style="@style/GbxTile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_session"
                android:text="SESSÕES" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/modBattery"
                style="@style/GbxTile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_battery"
                android:text="BATERIA" />

            <TextView
                android:id="@+id/modStorage"
                style="@style/GbxTile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_storage"
                android:text="ARMAZENAMENTO" />

            <TextView
                android:id="@+id/modSettings"
                style="@style/GbxTile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_settings"
                android:text="PERMISSÕES" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/footer"
            android:textColor="@color/text_faint"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
