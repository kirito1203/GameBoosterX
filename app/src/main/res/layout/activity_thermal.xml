<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_glow"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <com.gameboosterx.rog.views.GaugeView
                    android:id="@+id/gaugeThermal"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/txtThermalDetails"
                    style="@style/GbxBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="@color/text"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtThermalAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                style="@style/GbxSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="HISTÓRICO DE TEMPERATURA" />

            <com.gameboosterx.rog.views.LineChartView
                android:id="@+id/chartThermal"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:padding="4dp" />

            <LinearLayout
                android:id="@+id/thermalContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
