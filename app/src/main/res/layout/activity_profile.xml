<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_glow"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/profileIcon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profileName"
                        style="@style/GbxTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/profileType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/red"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPlay"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="2"
                    android:background="@drawable/bg_turbo_main"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center"
                    android:letterSpacing="0.2"
                    android:text="▶ JOGAR AGORA"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnAppInfo"
                    style="@style/GbxNeonButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="INFO"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                style="@style/GbxSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="PERFIL AUTOMÁTICO" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <Switch
                    android:id="@+id/swMonitor"
                    style="@style/GbxSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reconhecer este jogo" />

                <Switch
                    android:id="@+id/swDnd"
                    style="@style/GbxSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ativar Não Perturbe ao jogar" />

                <Switch
                    android:id="@+id/swSidebar"
                    style="@style/GbxSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mostrar Game Sidebar ao jogar" />

                <Switch
                    android:id="@+id/swRecord"
                    style="@style/GbxSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gravar sessão" />

                <Switch
                    android:id="@+id/swShortcut"
                    style="@style/GbxSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Atalho na Game Sidebar" />

                <Switch
                    android:id="@+id/swBright"
                    style="@style/GbxSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Definir brilho ao jogar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="10dp">

                    <SeekBar
                        android:id="@+id/seekBright"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/red"
                        android:thumbTint="@color/red" />

                    <TextView
                        android:id="@+id/txtBrightVal"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/text"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profileContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
