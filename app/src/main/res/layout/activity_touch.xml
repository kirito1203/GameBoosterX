<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="24dp">
            <com.gameboosterx.rog.views.TouchTestView
                android:id="@+id/touchTest"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:background="@drawable/bg_card_glow" />

            <TextView
                android:id="@+id/txtTouchStats"
                style="@style/GbxBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:text="Arraste o dedo pela área acima por alguns segundos."
                android:textColor="@color/text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnTouchReset"
                style="@style/GbxNeonButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:text="REPETIR TESTE" />

            <LinearLayout
                android:id="@+id/touchContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
