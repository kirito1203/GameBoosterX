<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout style="@style/Card" android:layout_marginTop="0dp">
        <TextView style="@style/CardTitle" android:text="Calibração de sincronia (SOLAR RHYTHM)" />
        <TextView
            style="@style/Body"
            android:text="1. Use a saída de áudio com que você joga (fone com fio, Bluetooth ou alto-falante).\n2. Toque em Iniciar: o app toca 24 batidas a 80 BPM.\n3. Toque no círculo no ritmo de cada batida, ouvindo o som.\nAs 4 primeiras batidas são aquecimento e não entram no cálculo. Só resultados consistentes podem ser salvos." />
        <TextView
            android:id="@+id/txtStatus"
            style="@style/BodyStrong"
            android:layout_marginTop="8dp" />
        <Button
            android:id="@+id/btnStart"
            style="@style/Btn"
            android:text="Iniciar calibração" />
    </LinearLayout>

    <TextView
        android:id="@+id/tapPad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_tap_pad"
        android:gravity="center"
        android:minHeight="140dp"
        android:text="TOQUE AQUI\nNO RITMO"
        android:textColor="@color/solar_gold"
        android:textSize="26sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:id="@+id/txtVerdict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtResult"
                style="@style/BodyStrong"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btnSave"
                style="@style/BtnOutline"
                android:enabled="false"
                android:text="Salvar este offset no perfil" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
