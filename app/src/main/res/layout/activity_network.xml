<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="24dp">
            <TextView
                android:id="@+id/txtNetConn"
                style="@style/GbxBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:textColor="@color/text" />

            <EditText
                android:id="@+id/editHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:autofillHints=""
                android:background="@drawable/bg_edit"
                android:hint="Servidor (IP ou domínio)"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_faint"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hostGoogle"
                    style="@style/GbxSmallButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="Google DNS" />

                <TextView
                    android:id="@+id/hostCloudflare"
                    style="@style/GbxSmallButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="Cloudflare" />

                <TextView
                    android:id="@+id/hostRoblox"
                    style="@style/GbxSmallButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="Roblox" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_glow"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/txtPing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:shadowColor="@color/cyan"
                    android:shadowRadius="14"
                    android:text="-- ms"
                    android:textColor="@color/text"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtQuality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Aguardando medição"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.gameboosterx.rog.views.LineChartView
                    android:id="@+id/chartPing"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/txtNetStats"
                    style="@style/GbxBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPingMonitor"
                    style="@style/GbxNeonButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="MONITOR CONTÍNUO"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnStability"
                    style="@style/GbxNeonButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="TESTE DE ESTABILIDADE"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtNetEvents"
                style="@style/GbxBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:text="Nenhuma oscilação detectada."
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/netContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
