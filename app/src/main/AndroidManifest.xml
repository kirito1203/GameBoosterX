<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        ETAPA 1: nenhuma permissão é necessária.
        Permissões entram só junto com o código que as usa:
          ETAPA 3 → FOREGROUND_SERVICE, FOREGROUND_SERVICE_MEDIA_PLAYBACK, POST_NOTIFICATIONS
          ETAPA 6 → SYSTEM_ALERT_WINDOW (painel flutuante)
        A importação (ETAPA 5) usa o Storage Access Framework e não exige permissão de armazenamento.
    -->

    <application
        android:name=".MemeSoundboardApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MemeSoundboardX">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MemeSoundboardX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
